<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.Views.HomePage"
    Title="My Tasks">

    <Grid Padding="20"
          RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="My Tasks"
                FontSize="28"
                FontAttributes="Bold"/>

            <Label
                Text="{Binding TotalTasks,
                StringFormat='Total Tasks: {0}'}"/>

            <Label
                Text="{Binding CompletedTasks,
                StringFormat='Completed: {0}'}"/>

            <Label
                Text="{Binding PendingTasks,
                StringFormat='Pending: {0}'}"/>

        </VerticalStackLayout>

        <!-- Task List -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Tasks}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedTask}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame
                        Margin="5"
                        Padding="10">

                        <VerticalStackLayout>

                            <Label
                                FontSize="18"
                                FontAttributes="Bold"
                                Text="{Binding Title}" />

                            <Label
                                Text="{Binding Description}" />

                            <Label
                                Text="{Binding Category}" />

                            <Label
                                Text="{Binding DueDate,
                                StringFormat='Due: {0:dd MMM yyyy}'}"/>

                            <Label
                                Text="{Binding IsCompleted,
                                StringFormat='Completed: {0}'}"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Add Button -->
        <Button
            Grid.Row="2"
            Text="Add Task"
            Command="{Binding AddTaskCommand}" />

    </Grid>

</ContentPage>