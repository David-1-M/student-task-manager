<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.Views.HomePage"
    Title="My Tasks">

    <Grid Padding="20"
          RowDefinitions="Auto,*,Auto">

        <Label
            Text="My Tasks"
            FontSize="28"
            FontAttributes="Bold"/>

        <CollectionView
            ItemsSource="{Binding Tasks}"
            SelectionMode="Single"
            SelectionChanged="CollectionView_SelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                Margin="5"
                Padding="10">

                        <VerticalStackLayout>

                            <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="{Binding Title}" />

                            <Label
                        Text="{Binding Description}" />

                            <Label
                        Text="{Binding Category}" />

                            <Label
                        Text="{Binding DueDate,
                        StringFormat='Due: {0:dd MMM yyyy}'}"/>

                        </VerticalStackLayout>

                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button
            Grid.Row="2"
            Text="Add Task"
            Command="{Binding AddTaskCommand}" />

    </Grid>

</ContentPage>