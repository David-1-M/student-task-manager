<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.Views.HomePage"
    Title="My Tasks">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="5">

            <Label
                Text="My Tasks"
                FontSize="28"
                FontAttributes="Bold"/>

            <Label
                Text="{Binding TotalTasks,
                StringFormat='Total Tasks: {0}'}"/>

            <Label
                Text="{Binding CompletedTasks,
                StringFormat='Completed: {0}'}"/>

            <Label
                Text="{Binding PendingTasks,
                StringFormat='Pending: {0}'}"/>

        </VerticalStackLayout>

        <SearchBar
            Grid.Row="1"
            Placeholder="Search tasks..."
            Text="{Binding SearchText}" />

        <Picker
            Grid.Row="2"
            Title="Filter Category"
            ItemsSource="{Binding Categories}"
            SelectedItem="{Binding SelectedCategory}" />

        <!-- Task List -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Tasks}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedTask}">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame
                        Margin="6"
                        Padding="15"
                        CornerRadius="12"
                        HasShadow="True"
                        BorderColor="LightGray">

                        <VerticalStackLayout
                            Spacing="6">

                            <Label
                                Text="{Binding Title}"
                                FontSize="20"
                                FontAttributes="Bold"/>

                            <Label
                                Text="{Binding Description}"
                                FontSize="14"/>

                            <HorizontalStackLayout
                                Spacing="12">

                            <Label
                                Text="{Binding Category}"
                                FontAttributes="Bold"/>

                            <Label
                                Text="{Binding DueDate,
                                StringFormat='📅 {0:dd MMM yyyy}'}"/>

                            <Label
                                Text="{Binding PriorityDisplay}" />
                        </HorizontalStackLayout>

                            <Label
                            Text="{Binding StatusText}"
                            FontAttributes="Italic"/>


                            <Label
                                Text="{Binding DueStatus}" />
                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Add Button -->
        <Button
            Grid.Row="4"
            Text="Add Task"
            Command="{Binding AddTaskCommand}" />

    </Grid>

</ContentPage>