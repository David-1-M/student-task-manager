<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.Views.HomePage"
    Title="Student Task Manager">

    <ScrollView>
        
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
        RowSpacing="10">

        <!-- ========================= -->
        <!-- DASHBOARD HEADER -->
        <!-- ========================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="15">

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <!-- Total -->
                <Frame
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>
                        <Label
                            Text="Total Tasks"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding TotalTasks}"
                            FontSize="28" />
                    </VerticalStackLayout>

                </Frame>

                <!-- Completed -->
                <Frame
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>
                        <Label
                            Text="Completed"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding CompletedTasks}"
                            FontSize="28" />
                    </VerticalStackLayout>

                </Frame>

                <!-- Pending -->
                <Frame
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>
                        <Label
                            Text="Pending"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding PendingTasks}"
                            FontSize="28" />
                    </VerticalStackLayout>

                </Frame>

                <!-- Overdue -->
                <Frame
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="15"
                    CornerRadius="12">

                    <VerticalStackLayout>
                        <Label
                            Text="Overdue"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding OverdueTasks}"
                            FontSize="28" />
                    </VerticalStackLayout>

                </Frame>

            </Grid>

            <!-- Progress -->
            <ProgressBar
                Progress="{Binding CompletionProgress}"
                HeightRequest="8" />

            <Label
                Text="{Binding HighPriorityTasks,
                       StringFormat='High Priority Tasks: {0}'}"
                FontAttributes="Bold" />

        </VerticalStackLayout>


        <!-- ========================= -->
        <!-- SEARCH -->
        <!-- ========================= -->

        <SearchBar
            Grid.Row="1"
            Placeholder="Search tasks..."
            Text="{Binding SearchText}" />


        <!-- ========================= -->
        <!-- CATEGORY -->
        <!-- ========================= -->

        <Picker
            Grid.Row="2"
            Title="Filter by Category"
            ItemsSource="{Binding Categories}"
            SelectedItem="{Binding SelectedCategory}" />


        <!-- ========================= -->
        <!-- SORT -->
        <!-- ========================= -->

        <Picker
            Grid.Row="3"
            Title="Sort By"
            ItemsSource="{Binding SortOptions}"
            SelectedItem="{Binding SelectedSort}" />


        <!-- ========================= -->
        <!-- TASK LIST -->
        <!-- ========================= -->

        <!-- Task List -->
        <Grid Grid.Row="4">

            <CollectionView
        ItemsSource="{Binding Tasks}"
        SelectionMode="Single"
        SelectedItem="{Binding SelectedTask}">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <SwipeView>

                            <SwipeView.LeftItems>

                                <SwipeItems>

                                    <SwipeItem
                                Text="Complete"
                                BackgroundColor="Green"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                  Path=BindingContext.CompleteTaskCommand}"
                                CommandParameter="{Binding .}" />

                                </SwipeItems>

                            </SwipeView.LeftItems>

                            <SwipeView.RightItems>

                                <SwipeItems>

                                    <SwipeItem
                                Text="Delete"
                                BackgroundColor="Red"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                  Path=BindingContext.DeleteTaskCommand}"
                                CommandParameter="{Binding .}" />

                                </SwipeItems>

                            </SwipeView.RightItems>

                            <Frame
                                Margin="6"
                                Padding="15"
                                CornerRadius="12"
                                HasShadow="True"
                                BorderColor="LightGray">

                                <VerticalStackLayout
                            Spacing="8">

                                    <Label
                                Text="{Binding Title}"
                                FontSize="20"
                                FontAttributes="Bold"/>

                                    <Label
                                Text="{Binding Description}"
                                LineBreakMode="TailTruncation"/>

                                    <HorizontalStackLayout
                                Spacing="12">

                                        <Label
                                    Text="{Binding Category}"
                                    FontAttributes="Bold"/>

                                        <Label
                                    Text="{Binding Priority}"
                                    TextColor="{Binding PriorityColor}"
                                    FontAttributes="Bold"/>

                                    </HorizontalStackLayout>

                                    <Label
                                Text="{Binding DueDate,
                                       StringFormat='Due: {0:dd MMM yyyy}'}"/>

                                    <Label
                                Text="{Binding DueStatus}"
                                FontAttributes="Italic"/>

                                <Label
                                    Text="{Binding StatusText}"
                                    FontAttributes="Italic"/>

                                </VerticalStackLayout>

                            </Frame>

                        </SwipeView>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <!-- Empty State -->
            <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="10"
        IsVisible="{Binding IsTaskListEmpty}">

                <Label
            Text="📋"
            FontSize="50"
            HorizontalOptions="Center"/>

                <Label
            Text="No tasks yet"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center"/>

                <Label
            Text="Create your first task to get started."
            FontSize="15"
            TextColor="Gray"
            HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

        </Grid>


        <!-- ========================= -->
        <!-- ADD TASK -->
        <!-- ========================= -->

        <HorizontalStackLayout
            Grid.Row="5"
            HorizontalOptions="Fill"
            Spacing="10">

        <Button
            Text="Add Task"
            HorizontalOptions="FillAndExpand"
            Command="{Binding AddTaskCommand}" />

        <Button
            Text="⚙️"
            WidthRequest="60"
            Command="{Binding OpenSettingsCommand}" />

        </HorizontalStackLayout>

    </Grid>

   </ScrollView>

</ContentPage>