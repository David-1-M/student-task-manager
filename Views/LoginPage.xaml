<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.Views.LoginPage"
    Title="Login">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <!-- App Branding -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="📋"
                    FontSize="60"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Student Task Manager"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="Stay organised. Stay productive."
                    FontSize="14"
                    TextColor="Gray"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

            <!-- Login Form -->
            <VerticalStackLayout
                Spacing="15">

                <Entry
                    Placeholder="Email"
                    Keyboard="Email"
                    Text="{Binding Email}"/>

                <Entry
                    Placeholder="Password"
                    IsPassword="True"
                    Text="{Binding Password}"/>

                <Button
                    Text="Login"
                    HeightRequest="50"
                    Command="{Binding LoginCommand}"/>

            </VerticalStackLayout>

            <!-- Register -->
            <VerticalStackLayout
                Spacing="8"
                HorizontalOptions="Center">

                <Label
                    Text="Don't have an account?"
                    HorizontalTextAlignment="Center"
                    TextColor="Gray"/>

                <Button
                    Text="Create Account"
                    BackgroundColor="Transparent"
                    TextColor="#512BD4"
                    Command="{Binding RegisterCommand}"/>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>