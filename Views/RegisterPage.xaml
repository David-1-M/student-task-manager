<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.Views.RegisterPage"
    Title="Create Account">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="18">

            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="📋"
                    FontSize="50"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Create Account"
                    FontSize="28"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="Start managing your tasks today."
                    FontSize="14"
                    TextColor="Gray"
                    HorizontalTextAlignment="Center"/>

            </VerticalStackLayout>

            <Entry
                Placeholder="Full Name"
                Text="{Binding FullName}"/>

            <Entry
                Placeholder="Email"
                Keyboard="Email"
                Text="{Binding Email}"/>

            <Entry
                Placeholder="Password"
                IsPassword="True"
                Text="{Binding Password}"/>

            <Entry
                Placeholder="Confirm Password"
                IsPassword="True"
                Text="{Binding ConfirmPassword}"/>

            <Button
                Text="Register"
                HeightRequest="50"
                Command="{Binding RegisterCommand}"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>